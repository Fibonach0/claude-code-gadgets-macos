#!/usr/bin/env python3
"""Saca de tus sesiones las decisiones que tomaste, y por qué.

Lo valioso de una sesión larga no es el código: es por qué se hizo así y qué se
descartó. Eso queda enterrado en miles de líneas de transcript y se pierde.

    claude-decisiones                    todos los proyectos con trabajo reciente
    claude-decisiones --proyecto hub
    claude-decisiones --dias 60
    claude-decisiones --en-repo          escribe DECISIONES.md dentro del repo

Por defecto escribe en ~/Documents/Decisiones/<proyecto>.md, sin tocar tus
repos. Cada corrida agrega lo nuevo al principio y conserva lo anterior.
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import subprocess
import sys
from collections import defaultdict
from datetime import datetime, timedelta

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import tx  # noqa: E402

TOPE = 90_000       # caracteres de transcript que se le pasan al modelo
SALIDA = pathlib.Path.home() / "Documents" / "Decisiones"
PISTAS = ("porque", "en vez de", "decidimos", "decidí", "conviene", "mejor",
          "el problema es", "no sirve", "descartamos", "la razón", "ojo",
          "cuidado", "en realidad", "resulta que", "la trampa")


def texto_de(obj: dict) -> str:
    msg = obj.get("message") or {}
    c = msg.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return "\n".join(b.get("text") or "" for b in c
                         if isinstance(b, dict) and b.get("type") == "text")
    return ""


def jugosos(archivo: str) -> list:
    """Los tramos donde se explica un porqué, que es lo que vale la pena."""
    trozos = []
    try:
        with open(archivo, errors="ignore") as fh:
            for linea in fh:
                bajo = linea.lower()
                if not any(p in bajo for p in PISTAS):
                    continue
                try:
                    o = json.loads(linea)
                except json.JSONDecodeError:
                    continue
                t = texto_de(o).strip()
                if len(t) < 120:
                    continue
                puntos = sum(t.lower().count(p) for p in PISTAS)
                trozos.append((puntos, t[:2500]))
    except OSError:
        return []
    trozos.sort(key=lambda x: -x[0])
    return [t for _, t in trozos[:12]]


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dias", type=int, default=30)
    ap.add_argument("--proyecto", default="")
    ap.add_argument("--en-repo", action="store_true")
    ap.add_argument("--modelo", default=os.environ.get("DECISIONES_MODELO", "sonnet"))
    a = ap.parse_args()

    desde = (datetime.now().astimezone() - timedelta(days=a.dias)).replace(
        hour=0, minute=0, second=0, microsecond=0)
    por_proyecto = defaultdict(list)
    for s in tx.sesiones(desde):
        if a.proyecto and a.proyecto.lower() not in s["proyecto"].lower():
            continue
        if s["minutos"] < 10:
            continue
        por_proyecto[(s["proyecto"], s["cwd"])].append(s)
    if not por_proyecto:
        print("No hay sesiones largas en ese período.")
        return

    SALIDA.mkdir(parents=True, exist_ok=True)
    for (proyecto, cwd), sesiones in por_proyecto.items():
        material, usado = [], 0
        for s in sorted(sesiones, key=lambda x: x["desde"]):
            for t in jugosos(s["archivo"]):
                bloque = "\n--- %s ---\n%s" % (s["dia"], t)
                if usado + len(bloque) > TOPE:
                    break
                material.append(bloque); usado += len(bloque)
        if not material:
            print("· %s: no encontré discusiones con justificación." % proyecto)
            continue

        pedido = (
            "Estos son fragmentos de sesiones de trabajo sobre el proyecto %s.\n\n"
            "Extraé las DECISIONES que se tomaron y por qué. Una viñeta por decisión, "
            "con esta forma:\n"
            "- **Qué se decidió** — por qué, y qué se descartó o qué problema evita.\n\n"
            "Reglas: en castellano rioplatense; sólo lo que esté en los fragmentos, sin "
            "inventar; nada de pasos ni de código; si algo quedó explícitamente pendiente "
            "o sin confirmar, ponelo al final bajo '### Sin cerrar'. Si no hay decisiones "
            "de fondo, decí sólo 'Sin decisiones de fondo en este período.'\n\n%s"
            % (proyecto, "\n".join(material))
        )
        r = subprocess.run(
            ["claude", "-p", pedido, "--no-session-persistence", "--model", a.modelo,
             "--permission-mode", "dontAsk", "--allowedTools", ""],
            capture_output=True, text=True, stdin=subprocess.DEVNULL)
        texto = (r.stdout or r.stderr).strip()
        if not texto:
            print("· %s: no pude extraer nada." % proyecto)
            continue

        destino = (pathlib.Path(cwd) / "DECISIONES.md" if a.en_repo and cwd
                   else SALIDA / ("%s.md" % proyecto))
        anterior = destino.read_text(encoding="utf-8") if destino.exists() else ""
        encabezado = "# Decisiones · %s\n" % proyecto
        anterior = anterior.replace(encabezado, "", 1).lstrip()
        nuevo = "%s\n## Hasta el %s\n\n%s\n" % (
            encabezado, datetime.now().strftime("%d/%m/%Y"), texto)
        destino.write_text(nuevo + ("\n" + anterior if anterior else ""), encoding="utf-8")
        print("· %s → %s" % (proyecto, destino))


if __name__ == "__main__":
    main()
